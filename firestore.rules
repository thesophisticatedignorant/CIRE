rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Analytics & Visitor Metadata Logging
    match /analytics_metadata/{docId} {
      allow create: if request.resource.data.keys().hasAny(['timestamp', 'userAgent', 'language', 'referrer']);
      allow read, update, delete: if false;
    }

    // 2. Cookie Consent Choices
    match /cookie_consents/{docId} {
      allow create: if request.resource.data.consent in ['granted', 'declined'];
      allow read, update, delete: if false;
    }

    // 3. Access Requests Submissions
    match /request_access/{docId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // 4. CIRE Concierge Inquiries (vehicles)
    //    Separate business line from Sophisticated Brilliance - deliberately a
    //    separate collection so the two never mix.
    //
    //    The old shared `private_inquiry` rule required `vehicle is string`,
    //    but the form writes `category` / `model` / `vehicleCount` and never a
    //    `vehicle` key, so every submission was rejected and the error was
    //    swallowed by the caller's catch block. Validated on name + email, the
    //    same pair request_access uses and the same pair the form guarantees.
    match /concierge_inquiry/{docId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // 5. Sophisticated Brilliance Inquiries (jewellery)
    match /brilliance_inquiry/{docId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // 6. Join Network Submissions
    //    The document itself is the map node: name, colour and coordinates.
    //    Reads are open because the map plots these in every visitor's browser
    //    - anything it can read is public by definition, so there is nothing
    //    here that is not meant to be seen.
    //
    //    Contact details are NOT in this document. Firestore rules are
    //    per-document and cannot expose one field while hiding another, so
    //    email, Instagram handle and the raw IP geolocation live in the
    //    private subcollection below, which nothing grants read access to.
    //    READS ARE CLOSED PENDING MIGRATION. Documents written before the
    //    split still carry `email`, `ig` and `locationData` at the top level,
    //    so opening reads exposed them. Run scripts/migrate-join-network.cjs
    //    to move those fields into the private subcollection, then change the
    //    line below back to `allow read: if true;` and redeploy to restore the
    //    map pins.
    match /join_network/{docId} {
      allow read: if false;
      allow create: if request.resource.data.name is string;
      allow update, delete: if false;

      // Legacy. Documents written during the subcollection era keep their
      // contact record here; nothing writes to it any more.
      match /private/{privateDoc} {
        allow create: if request.resource.data.email is string;
        allow read, update, delete: if false;
      }
    }

    // 6b. Join Network - private half
    //     Email, Instagram handle and raw IP geolocation for each node, tied
    //     back to its pin by `nodeId`. Write-only: the form adds records, the
    //     notifier reads them with a service account, and nothing else can
    //     read them at all. A separate top-level collection rather than a
    //     subcollection so the public/private split is one rule each and the
    //     private side can be read as a single collection by admin tooling.
    match /join_network_private/{docId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.nodeId is string;
      allow read, update, delete: if false;
    }

    // 7. Legacy: retained so historical documents stay readable to admin
    //    tooling. Nothing writes here any more - concierge and brilliance
    //    submissions go to their own collections above.
    match /private_inquiry/{docId} {
      allow read, write: if false;
    }

    // 8. Default Fallback Safety Net (Block all unhandled collections)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
